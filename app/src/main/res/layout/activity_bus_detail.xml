<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".BusDetailActivity"
    android:background="@drawable/background"
    android:backgroundTint="#1640D6"
    android:orientation="vertical"
    android:gravity="center_horizontal">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical">
        <TextView
            android:layout_width="300dp"
            android:layout_height="50dp"
            android:layout_marginTop="40dp"
            android:text="Trip Information"
            android:textAlignment="center"
            android:textColor="@color/white"
            android:textSize="25dp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="300dp"
            android:layout_height="30dp"
            android:text='"our buses are bussin either way"'
            android:textAlignment="center"
            android:textColor="#95ffffff"
            android:textSize="20dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:background="@drawable/background_mini">
        <LinearLayout
            android:layout_width="340dp"
            android:layout_height="40dp"
            android:orientation="horizontal">
            <TextView
                android:layout_width="170dp"
                android:layout_height="wrap_content"
                android:text="Bus Name                         :"
                android:textColor="@color/white"/>
            <TextView
                android:id="@+id/display_bus_name"
                android:layout_width="170dp"
                android:layout_height="wrap_content"
                android:textColor="@color/white"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="340dp"
            android:layout_height="40dp"
            android:orientation="horizontal">
            <TextView
                android:layout_width="170dp"
                android:layout_height="wrap_content"
                android:text="Bus Type                           :"
                android:textColor="@color/white"/>
            <TextView
                android:id="@+id/display_bus_type"
                android:layout_width="170dp"
                android:layout_height="wrap_content"
                android:textColor="@color/white"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="340dp"
            android:layout_height="40dp"
            android:orientation="horizontal">
            <TextView
                android:layout_width="170dp"
                android:layout_height="wrap_content"
                android:text="Capacity                            :"
                android:textColor="@color/white"/>
            <TextView
                android:id="@+id/display_capacity"
                android:layout_width="170dp"
                android:layout_height="wrap_content"
                android:textColor="@color/white"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="340dp"
            android:layout_height="80dp"
            android:orientation="horizontal">
            <TextView
                android:layout_width="170dp"
                android:layout_height="wrap_content"
                android:text="Facilities                            :"
                android:textColor="@color/white"/>
            <TextView
                android:id="@+id/display_facilities"
                android:layout_width="170dp"
                android:layout_height="wrap_content"
                android:textColor="@color/white"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="340dp"
            android:layout_height="40dp"
            android:orientation="horizontal">
            <TextView
                android:layout_width="170dp"
                android:layout_height="wrap_content"
                android:text="Departure                          :"
                android:textColor="@color/white"/>
            <TextView
                android:id="@+id/display_departure"
                android:layout_width="170dp"
                android:layout_height="wrap_content"
                android:textColor="@color/white"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="340dp"
            android:layout_height="40dp"
            android:orientation="horizontal">
            <TextView
                android:layout_width="170dp"
                android:layout_height="wrap_content"
                android:text="Arrival                                 :"
                android:textColor="@color/white"/>
            <TextView
                android:id="@+id/display_arrival"
                android:layout_width="170dp"
                android:layout_height="wrap_content"
                android:textColor="@color/white"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="340dp"
            android:layout_height="40dp"
            android:orientation="horizontal">
            <TextView
                android:layout_width="170dp"
                android:layout_height="wrap_content"
                android:text="Price                                    :"
                android:textColor="@color/white"/>
            <TextView
                android:id="@+id/display_price"
                android:layout_width="170dp"
                android:layout_height="wrap_content"
                android:textColor="@color/white"/>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:background="@drawable/background_mini"
        android:layout_marginTop="20dp">
        <TextView
            android:id="@+id/title_departure"
            android:layout_width="340dp"
            android:layout_height="30dp"
            android:text="Departure Schedule"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textAlignment="center"
            android:textSize="20dp"/>
        <LinearLayout
            android:id="@+id/date_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="15dp"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="3dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/title_departure">
            <TextView
                android:layout_width="96dp"
                android:layout_height="wrap_content"
                android:text="Date"
                android:textColor="#FFFFFF"
                android:textSize="18dp" />
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/baseline_calendar_month_24"/>
            <Spinner
                android:id="@+id/date_dropdown"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:popupBackground="@android:color/background_light" />
        </LinearLayout>

        <Button
            android:id="@+id/makebook_button"
            android:layout_width="200dp"
            android:layout_height="60dp"
            android:text="make booking"
            android:background="@drawable/background_listview"
            android:textColor="@color/white"
            android:layout_marginTop="40dp"/>
    </LinearLayout>


</LinearLayout>