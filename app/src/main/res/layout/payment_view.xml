<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:backgroundTint="#D30482"
    android:background="@drawable/background_listview"
    tools:ignore="UselessParent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/bus_name"
                android:layout_width="150dp"
                android:layout_height="32dp"
                android:layout_marginLeft="10dp"
                android:gravity="bottom|left"
                android:text="BusName"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:ignore="RtlHardcoded" />
            <TextView
                android:id="@+id/status"
                android:layout_width="70dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"
                android:gravity="bottom|left"
                android:text="Status :"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:ignore="RtlHardcoded" />
            <TextView
                android:id="@+id/status_display"
                android:layout_width="150dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginLeft="10dp"
                android:gravity="bottom|left"
                android:textColor="#FFFFFF"
                android:text="WAITING"
                android:textSize="25sp"
                tools:ignore="RtlHardcoded"
                />
        </LinearLayout>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/terminal"
                android:layout_width="240sp"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:layout_marginLeft="4dp"
                android:gravity="top|left"
                android:textColor="#99FFFFFF"
                android:text="TERMINAL MIMIK - TERMINAL MIMEK"
                android:textSize="10sp"
                tools:ignore="RtlHardcoded" />
            <TextView
                android:id="@+id/date"
                android:layout_width="240sp"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:gravity="top|left"
                android:textColor="#99FFFFFF"
                android:text="DECEMBER 31"
                android:textSize="10sp"
                tools:ignore="RtlHardcoded" />

        </LinearLayout>
    </LinearLayout>
</LinearLayout>